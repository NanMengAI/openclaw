# OpenClaw 中国版环境变量配置示例
# 复制此文件为 .env 并填入您的实际配置

# ============================================
# 基础配置
# ============================================

# OpenClaw镜像版本
OPENCLAW_IMAGE=openclaw:latest-cn

# 配置文件目录
OPENCLAW_CONFIG_DIR=./openclaw-data

# 工作空间目录
OPENCLAW_WORKSPACE_DIR=./openclaw-workspace

# 网关端口
OPENCLAW_GATEWAY_PORT=18789

# 桥接端口
OPENCLAW_BRIDGE_PORT=18790

# ============================================
# 网关安全配置（推荐设置）
# ============================================

# 网关访问令牌（推荐设置以提高安全性）
OPENCLAW_GATEWAY_TOKEN=your-secure-token-here

# 或使用密码认证
# OPENCLAW_GATEWAY_PASSWORD=your-secure-password-here

# ============================================
# AI模型配置
# ============================================

# 方式1: 使用南梦AI（推荐）
# 访问 https://www.nanmengai.cn 注册并获取API密钥
OPENAI_API_KEY=sk-your-nanmeng-api-key
OPENAI_BASE_URL=https://api.nanmengai.cn/v1

# 方式2: 使用OpenAI官方
# OPENAI_API_KEY=sk-your-openai-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1

# 方式3: 使用其他OpenAI兼容平台
# OPENAI_API_KEY=your-api-key
# OPENAI_BASE_URL=https://your-api-endpoint/v1

# 默认模型（可选）
# OPENCLAW_DEFAULT_MODEL=gpt-4o

# ============================================
# 企业微信配置
# ============================================

# 访问 https://work.weixin.qq.com/ 创建应用并获取凭证
# WECOM_CORP_ID=your-corp-id
# WECOM_CORP_SECRET=your-corp-secret
# WECOM_AGENT_ID=your-agent-id

# ============================================
# 钉钉配置
# ============================================

# 访问 https://open.dingtalk.com/ 创建应用并获取凭证
# DINGTALK_APP_KEY=your-app-key
# DINGTALK_APP_SECRET=your-app-secret
# DINGTALK_ROBOT_CODE=your-robot-code

# ============================================
# 飞书配置
# ============================================

# 访问 https://open.feishu.cn/ 创建应用并获取凭证
# FEISHU_APP_ID=cli_your-app-id
# FEISHU_APP_SECRET=your-app-secret
# FEISHU_DOMAIN=feishu  # 中国区使用 "feishu"，国际版使用 "lark"

# ============================================
# 其他渠道配置（可选）
# ============================================

# Telegram
# TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Discord
# DISCORD_BOT_TOKEN=your-discord-bot-token

# Slack
# SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

# ============================================
# 高级配置（可选）
# ============================================

# 日志级别 (debug, info, warn, error)
# LOG_LEVEL=info

# 会话存储路径
# OPENCLAW_SESSION_STORE=/home/node/.openclaw/sessions

# 启用开发模式
# NODE_ENV=development

# 时区设置
# TZ=Asia/Shanghai
